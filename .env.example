# PodX - Environment Variables Configuration Template
# Copy this file to .env for local development

# Application Configuration
APP_NAME="PodX - Elite Knowledge AI Podcast Studio"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
SECRET_KEY=podx-super-secret-key-change-in-production-local-only

# Storage Paths
DATABASE_URL=sqlite:///./storage/podx.db
STORAGE_PATH=./storage
AUDIO_STORAGE_PATH=./storage/audio
PREVIEW_STORAGE_PATH=./storage/previews
EXPORT_STORAGE_PATH=./storage/exports
DATASET_STORAGE_PATH=./storage/datasets
MODELS_DIR=./models

# Audio Generation Defaults
DEFAULT_MODEL_PROVIDER=kokoro
FALLBACK_MODEL_PROVIDER=kokoro
QUALITY_MODE=Studio
SAMPLE_RATE=24000
MASTERING_SAMPLE_RATE=48000
TARGET_LUFS=-16.0
TRUE_PEAK_LIMIT=-1.0

# Hardware & Inference Limits
MAX_VRAM_GB=4.0
MAX_RAM_GB=14.0
ENABLE_GPU=true
OFFLOAD_TO_CPU=true
MAX_PARALLEL_GENERATION_CHUNKS=2
